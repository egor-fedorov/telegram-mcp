{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.egor-fedorov/telegram-mcp",
  "title": "Telegram Context MCP",
  "description": "Read permitted Telegram chats, retrieve original posts and files, and track changes locally.",
  "repository": {
    "url": "https://github.com/egor-fedorov/telegram-mcp",
    "source": "github",
    "id": "1410391452"
  },
  "websiteUrl": "https://github.com/egor-fedorov/telegram-mcp#install-and-log-in",
  "version": "0.5.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "telegram-context-mcp",
      "version": "0.5.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--python",
          "value": "3.12"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
